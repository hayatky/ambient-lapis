# Ambient Lapis local configuration
#
# Copy this file to .env and replace the placeholder values.
# Never put a real Nature Remo token in this example file.

# Nature Remo credentials and target IDs
# Store the token itself in secrets/nature_remo_token with mode 0600.
NATURE_REMO_TOKEN_FILE=./secrets/nature_remo_token
NATURE_REMO_DEVICE_ID=replace-with-device-id
NATURE_REMO_APPLIANCE_ID=replace-with-appliance-id

# Go collector / internal API
DATABASE_PATH=./data/ambient-lapis.sqlite3
BACKUP_DIR=./backups
POLL_INTERVAL=5m
HTTP_TIMEOUT=15s
# Optional. Defaults to max(10m, 2 x POLL_INTERVAL).
# STALE_AFTER=10m
LISTEN_ADDR=:8080
LOG_LEVEL=info
TZ=Asia/Tokyo

# Next.js local development
# Docker Compose overrides this with http://remo-api:8080.
REMO_API_BASE_URL=http://127.0.0.1:8080

# Docker Compose host settings
# Use the full Git SHA from scripts/export-synology-images.sh in deployed environments.
APP_VERSION=replace-with-git-sha
AMBIENT_LAPIS_PORT=3000
AMBIENT_LAPIS_DATA_DIR=./data
AMBIENT_LAPIS_BACKUP_DIR=./backups
