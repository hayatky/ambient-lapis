{
  "name": "ambient-lapis-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "dev": "npm run check:node --silent && next dev",
    "dev:mock": "npm run check:node --silent && REMO_API_BASE_URL=http://127.0.0.1:8090 next dev",
    "mock-api": "npm run check:node --silent && node test/mock-api/server.ts",
    "build": "npm run check:node --silent && next build",
    "start": "npm run check:node --silent && next start",
    "lint": "npm run check:node --silent && eslint . --max-warnings=0",
    "typecheck": "npm run check:node --silent && tsc --noEmit",
    "format:check": "npm run check:node --silent && prettier --check .",
    "test:node": "npm run check:node --silent && node --test scripts/check-node-version.node-test.mjs",
    "test": "npm run test:node --silent && vitest run",
    "test:e2e": "npm run check:node --silent && playwright test"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "28.1.0",
    "postcss": "8.5.19",
    "prettier": "3.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
